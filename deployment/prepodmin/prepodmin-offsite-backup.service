[Unit]
Description=PREPODMIN encrypted offsite backup of SQLite and student submissions
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/prepodmin/restic/repository.password

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/lib/prepodmin-offsite/offsite_backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/prepodmin/offsite-staging
ReadOnlyPaths=/opt/bots/prepodmin/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
