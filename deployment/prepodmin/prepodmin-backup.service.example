[Unit]
Description=PREPODMIN daily SQLite snapshot (independent of EGE BLIZKO)
ConditionPathIsRegular=/opt/bots/prepodmin/data/teacher_product.sqlite3

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/bots/prepodmin/current/deployment/prepodmin
ExecStart=/usr/bin/python3 /opt/bots/prepodmin/current/deployment/prepodmin/daily_backup.py
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/backups/prepodmin
TimeoutStartSec=180
